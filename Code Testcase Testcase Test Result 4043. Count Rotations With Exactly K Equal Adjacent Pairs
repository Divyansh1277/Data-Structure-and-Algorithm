class Node{
    public:
    char data;
    Node* next;
    Node(char x){
        data = x;
        next = NULL;
    }
};
class Solution {
public:
    int countRotations(string s, int k) {
        vector<int>v;
        Node* head = NULL;
        Node* tail = NULL;
        Node* temp;
        for(int i=0;i<s.length();i++){
            char a = s[i];
            temp = new Node(a);
            if(head==NULL){
                head = temp;
                tail = temp;
            }
            else {
                tail->next = temp;
                tail = tail->next;
            }
        }
        int x = s.length();
        Node* temp2;
        for(int i=0;i<s.length();i++){
            int count = 0;
            Node* temp1=head;
            for(int j=0;j<s.length()-1;j++){
                if(temp1->data == temp1->next->data){
                    count++;
                }
                temp1 = temp1->next;
            }
            if(count>0) v.push_back(count);
            else v.push_back(0);
            temp2 = head;
            head = head->next;
            tail->next = temp2;
            tail = temp2;
            tail->next = NULL;
        }
        int count=0;
        int sum =0 ;
        for(int i=0;i<v.size();i++){
            sum += v[i];
            if(k==0 && v[i]==k){
                count++;
                continue;
            }
             else {
                 if(v[i]==k) count++;
             }
        }
        for(int i=0;i<v.size();i++){
            cout<<v[i]<<" ";
        }
        return count;
    }  
};
